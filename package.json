  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('ui/dist',{recursive:true});for(const f of ['index.html','styles.css'])fs.copyFileSync('ui/'+f,'ui/dist/'+f);fs.cpSync('ui/assets','ui/dist/assets',{recursive:true})\"",
    "watch": "tsc -w",
    "tauri": "tauri"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@tauri-apps/cli": "^2.1.0"
  }
}
