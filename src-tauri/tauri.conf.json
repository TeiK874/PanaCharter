{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PanaCharter",
  "version": "1.0.0",
  "identifier": "dev.ethanobrien.charter",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PanaCharter",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
